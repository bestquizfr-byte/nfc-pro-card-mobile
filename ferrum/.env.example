# Base de données (SQLite local). En production : URL PostgreSQL (Neon, Vercel Postgres…)
DATABASE_URL="file:./dev.db"

# URL publique du site (SEO, redirections Stripe)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mot de passe du dashboard /admin
ADMIN_PASSWORD="admin123"
# Secret de signature du cookie admin (mettre une longue chaîne aléatoire en production)
ADMIN_SECRET="change-moi-en-production-0123456789"

# Stripe — laisser vide pour le MODE DÉMO (commande simulée, aucun paiement)
# Clés : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Serveurs MCP (facultatif, utilisés par Claude Code via .mcp.json à la racine du dépôt)
CONTEXT7_API_KEY=""
