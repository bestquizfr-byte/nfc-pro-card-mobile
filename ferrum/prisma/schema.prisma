// FERRUM — schéma de données.
// SQLite en local. Pour la production (Vercel), passer provider à "postgresql"
// et DATABASE_URL vers Neon / Vercel Postgres (voir README).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  tagline        String
  description    String
  benefits       String      // JSON string[]
  specs          String      // JSON {label,value}[]
  sizeGuide      String?     // JSON {headers,rows}
  category       String
  price          Int         // centimes TTC
  compareAtPrice Int?        // centimes TTC (prix barré)
  costPrice      Int         // centimes (prix d'achat fournisseur)
  supplierName   String
  supplierUrl    String
  images         String      // JSON string[]
  badge          String?
  featured       Boolean     @default(false)
  isBundle       Boolean     @default(false)
  bundleItems    String?     // JSON slug[]
  upsells        String?     // JSON slug[]
  popularity     Int         @default(0)
  active         Boolean     @default(true)
  variants       Variant[]
  reviews        Review[]
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Variant {
  id        String      @id @default(cuid())
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  color     String?
  colorHex  String?
  size      String?
  sku       String      @unique
  stock     Int         @default(0)
  price     Int?        // surcharge éventuelle du prix produit
  image     String?
  position  Int         @default(0)
  orderItems OrderItem[]
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  author    String
  city      String?
  rating    Int
  title     String
  body      String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  email           String
  firstName       String
  lastName        String
  address         String
  address2        String?
  postalCode      String
  city            String
  country         String
  phone           String?
  subtotal        Int
  discount        Int         @default(0)
  shipping        Int
  total           Int
  promoCode       String?
  status          String      @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED
  paymentMode     String      @default("DEMO")    // DEMO | STRIPE
  stripeSessionId String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId   String?
  name        String
  variantName String
  image       String
  unitPrice   Int
  quantity    Int
}

model PromoCode {
  code    String  @id
  percent Int
  active  Boolean @default(true)
}

model Subscriber {
  email     String   @id
  createdAt DateTime @default(now())
}
